#!/usr/bin/env -S sh -eu

# Add a thick, border around a video, as if we were to scale the video
# down, toward the frame center. This also ensures output videos are 4K.

if [ "$#" -eq 0 ]
then >&2 printf '%s\n' "usage: ${0##*/} FILE..." ; exit 1
fi

ow='3840' ;
oh='2160'

iw="$((ow * 3 / 4))"
ih="$((oh * 3 / 4))"

c='black'

for f
do
	g="${f%.*}.${0##*/}.mp4"

	ffmpeg -i "$f" -vf "                                    \
	    scale=$iw:$ih:force_original_aspect_ratio=decrease, \
	    pad=$ow:$oh:(ow-iw)/2:(oh-ih)/2:color=$c
	" "$g"

	printf '%s\n' "${0##*/}: wrote to '$g'"
done
